// CodeForge v2 schema — see MASTER_PLAN.md §3 for full design context.
// Stage 0 (Foundation) introduces the full data model. Tables that are not yet
// populated by Stage 0 are scaffolded here so parallel Stage 1 agents can build
// on top of a stable contract.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, vector]
}

// ─── Identity & access ────────────────────────────────────────────────────────

enum Role {
  USER
  PROBLEM_SETTER
  REVIEWER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  username        String    @unique
  passwordHash    String?
  passwordAlgo    String    @default("argon2id") // "argon2id" | "bcrypt" (legacy)
  displayName     String?
  avatarUrl       String?
  bio             String?
  country         String?
  organization    String?
  oauthProvider   String?
  oauthId         String?
  totpSecret      String?
  totpEnabled     Boolean   @default(false)
  role            Role      @default(USER)
  isBanned        Boolean   @default(false)
  bannedReason    String?

  // Arena profile
  rating         Int       @default(1500)
  maxRating      Int       @default(1500)
  problemsSolved Int       @default(0)
  contestsCount  Int       @default(0)
  lastContestAt  DateTime?

  // Aptitude profile
  aptitudeTheta      Float @default(0)
  aptitudeScaled     Int   @default(500)
  aptitudeTestsTaken Int   @default(0)

  // Engagement
  currentStreak          Int       @default(0)
  longestStreak          Int       @default(0)
  streakFreezesAvailable Int       @default(2)
  coins                  Int       @default(0)
  lastActiveAt           DateTime?

  // Login throttling counters (reset by /auth/login on success)
  failedLoginCount      Int       @default(0)
  lockedUntil           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems         Problem[]            @relation("ProblemAuthor")
  submissions      Submission[]
  participations   ContestParticipant[]
  ratingChanges    RatingChange[]
  quizAttempts     QuizAttempt[]
  badges           UserBadge[]
  proctorEvents    ProctorEvent[]
  auditLogs        AuditLog[]
  sessions         UserSession[]
  verificationTokens VerificationToken[]
  passwordResets   PasswordResetToken[]
  practiceVersions PracticeVersion[] @relation("PracticeAuthor")
  practiceReviews  PracticeVersion[] @relation("PracticeReviewer")
  practiceJobs     PracticeJob[]
  practiceSolves   PracticeSolve[]
  authoredManifests    ContestManifest[]     @relation("ContestManifestAuthor")
  reviewedManifests    ContestManifest[]     @relation("ContestManifestReviewer")
  contestSubmissions   ContestSubmission[]
  ratingLedgerEntries  ContestRatingLedger[]
  contestDisputes      ContestDispute[]
  resolvedDisputes     ContestDispute[]      @relation("DisputeResolver")

  @@index([rating(sort: Desc)])
  @@index([aptitudeScaled(sort: Desc)])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  fingerprint      String?
  ipAddress        String
  userAgent        String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?

  @@index([userId])
  @@index([refreshTokenHash])
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  purpose   String   // "email-verify" only for now; reset uses PasswordResetToken
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  target    String?
  payload   Json     @default("{}")
  ipAddress String?
  requestId String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
}

// ─── Arena: problems & tests ─────────────────────────────────────────────────

enum ProblemJudgeMode {
  STDIO
  FUNCTIONAL
  INTERACTIVE
  OUTPUT_ONLY
}

enum ProblemScoring {
  BINARY
  ICPC_PENALTY
  ATCODER_POINTS
  IOI_SUBTASK
}

enum ProblemStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  RETIRED
}

enum Verdict {
  PENDING
  QUEUED
  COMPILING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT
  MEMORY_LIMIT
  RUNTIME_ERROR
  COMPILATION_ERROR
  OUTPUT_LIMIT
  PRESENTATION_ERROR
  JUDGE_FAILURE
  SKIPPED
}

model Problem {
  id      String @id @default(uuid())
  slug    String @unique
  version Int    @default(1)

  title       String
  statementMd String
  inputFormat String
  outputFormat String
  constraints String
  notes       String?

  difficultyBand   String
  rating           Int    @default(1500)
  estimatedMinutes Int    @default(20)

  judgeMode   ProblemJudgeMode @default(STDIO)
  scoringMode ProblemScoring   @default(BINARY)

  timeLimitMs          Int      @default(2000)
  memoryLimitKb        Int      @default(262144)
  outputLimitKb        Int      @default(64)
  codeLimitKb          Int      @default(64)
  perLanguageOverrides Json     @default("{}")
  allowedLanguages     String[] @default([])

  functionSignature Json?

  checkerType    String  @default("token")
  checkerCode    String?
  checkerEpsilon Float?

  interactorCode String?

  tags        String[] @default([])
  companyTags Json     @default("[]")
  source      String?
  license     String?

  status      ProblemStatus @default(DRAFT)
  isPublic    Boolean       @default(false)
  publishedAt DateTime?

  totalSubmissions Int   @default(0)
  totalAccepted    Int   @default(0)
  acceptanceRate   Float @default(0)
  likes            Int   @default(0)
  dislikes         Int   @default(0)

  authorId       String
  author         User     @relation("ProblemAuthor", fields: [authorId], references: [id])
  coordinatorIds String[] @default([])
  testerIds      String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tests              ProblemTest[]
  subtasks           ProblemSubtask[]
  starterCodes       StarterCode[]
  referenceSolutions ReferenceSolution[]
  hints              ProblemHint[]
  editorial          Editorial?
  submissions        Submission[]
  contestProblems    ContestProblem[]
  discussions        Discussion[]
  dailyChallenges    DailyChallenge[]
  practiceVersions   PracticeVersion[]
  practiceSolves     PracticeSolve[]
  contestSubmissions ContestSubmission[]

  @@index([status, isPublic])
  @@index([rating])
  @@index([difficultyBand])
  @@index([authorId])
}

model ProblemTest {
  id             String          @id @default(uuid())
  problemId      String
  problem        Problem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  subtaskId      String?
  subtask        ProblemSubtask? @relation(fields: [subtaskId], references: [id])
  orderIndex     Int
  isSample       Boolean         @default(false)
  inputBlobKey   String
  outputBlobKey  String
  inputSizeBytes Int             @default(0)
  explanationMd  String?

  @@index([problemId, orderIndex])
}

model ProblemSubtask {
  id           String        @id @default(uuid())
  problemId    String
  problem      Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  label        String
  points       Int
  aggregation  String        @default("min")
  dependsOnIds String[]      @default([])
  tests        ProblemTest[]
}

model StarterCode {
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language  String
  code      String

  @@id([problemId, language])
}

model ReferenceSolution {
  id             String  @id @default(uuid())
  problemId      String
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language       String
  code           String
  isJury         Boolean @default(true)
  complexityNote String?
}

model ProblemHint {
  id        String  @id @default(uuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  level     Int
  textMd    String
}

model Editorial {
  problemId   String    @id
  problem     Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  bodyMd      String
  publishedAt DateTime?
  authorId    String?
}

// ─── Arena: contests & submissions ───────────────────────────────────────────

enum ContestStatus {
  DRAFT
  SCHEDULED
  RUNNING
  ENDED
  FINALIZED
  CANCELLED
}

enum ContestFormat {
  ICPC
  IOI
  ATCODER
  CF_HACKS
  MIXED
}

model Contest {
  id                   String        @id @default(uuid())
  slug                 String        @unique
  title                String
  description          String?
  format               ContestFormat @default(ICPC)
  isRated              Boolean       @default(false)
  divisionMin          Int?
  divisionMax          Int?
  isPublic             Boolean       @default(true)
  passcode             String?
  status               ContestStatus @default(DRAFT)
  startTime            DateTime
  endTime              DateTime
  freezeAtMinutes      Int?
  freezeAt             DateTime?
  capacity             Int           @default(1000)
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  activeManifestId     String?
  activeManifest       ContestManifest? @relation("ActiveContestManifest", fields: [activeManifestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems            ContestProblem[]
  participants        ContestParticipant[]
  submissions         Submission[]
  ratingChanges       RatingChange[]
  hacks               Hack[]
  manifests           ContestManifest[]           @relation("ContestManifests")
  contestSubmissions  ContestSubmission[]
  scoreboardSnapshots ContestScoreboardSnapshot[]
  ratingLedgerEntries ContestRatingLedger[]
  disputes            ContestDispute[]
  settlementJobs      ContestSettlementJob[]

  @@index([status, startTime])
}

model ContestProblem {
  contestId String
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  label     String
  points    Int     @default(100)

  @@id([contestId, problemId])
}

model ContestParticipant {
  contestId      String
  contest        Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredAt   DateTime  @default(now())
  isVirtual              Boolean   @default(false)
  virtualStartAt         DateTime?
  score                  Int       @default(0)
  penalty                Int       @default(0)
  rank                   Int?
  problemStates          Json      @default("{}")
  status                 String    @default("REGISTERED") // "REGISTERED" | "WITHDRAWN" | "DISQUALIFIED"
  ratingAtRegistration   Int       @default(1500)
  withdrawnAt            DateTime?
  disqualifiedAt         DateTime?
  disqualificationReason String?

  @@id([contestId, userId])
  @@index([contestId, rank])
}

model Submission {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id])
  contestId   String?
  contest     Contest? @relation(fields: [contestId], references: [id])
  language    String
  codeBlobKey String
  codeSize    Int      @default(0)

  verdict            Verdict @default(PENDING)
  testsPassed        Int     @default(0)
  testsTotal         Int     @default(0)
  pointsAwarded      Int     @default(0)
  executionTimeMs    Int?
  memoryUsedKb       Int?
  compilerOutput     String?
  judgeWorkerHost    String?
  judgeKernelVersion String?

  submittedAt DateTime  @default(now())
  judgedAt    DateTime?

  pasteCount        Int   @default(0)
  pasteBytesTotal   Int   @default(0)
  keystrokeStats    Json?
  editorTimeSpentMs Int?

  results                  SubmissionTestResult[]
  similarityMatches        PlagiarismMatch[]      @relation("ToMatches")
  similarityMatchedAgainst PlagiarismMatch[]      @relation("FromMatches")

  @@index([userId, submittedAt(sort: Desc)])
  @@index([problemId])
  @@index([contestId])
  @@index([verdict])
}

model SubmissionTestResult {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testIndex    Int
  verdict      Verdict
  timeMs       Int?
  memoryKb     Int?
  checkerMsg   String?

  @@index([submissionId])
}

// Phase 2: immutable private packages and durable execution generations.
// Admission remains disabled until the isolated runtime is verified.
model PracticeJudgeRuntime {
  id           String   @id
  policy       Json
  policyHash   String
  evidenceHash String
  verifiedAt   DateTime
  heartbeatAt  DateTime
  expiresAt    DateTime
}

model PracticeVersion {
  id          String        @id @default(uuid())
  problemId   String
  problem     Problem       @relation(fields: [problemId], references: [id])
  number      Int
  authorId    String
  author      User          @relation("PracticeAuthor", fields: [authorId], references: [id])
  package     Json
  packageHash String
  status      String        @default("DRAFT")
  validation  Json?
  reviewerId  String?
  reviewer    User?         @relation("PracticeReviewer", fields: [reviewerId], references: [id])
  rightsBasis String?
  createdAt   DateTime      @default(now())
  approvedAt  DateTime?
  publishedAt DateTime?
  withdrawnAt DateTime?
  jobs        PracticeJob[]
  contestSubmissions ContestSubmission[]

  @@unique([problemId, number])
  @@index([problemId, status])
}

model PracticeJob {
  id             String          @id @default(uuid())
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id])
  versionId      String
  version        PracticeVersion @relation(fields: [versionId], references: [id])
  kind           String
  language       String
  source         String
  sourceHash     String
  input          String?
  requestHash    String
  idempotencyKey String
  policy         Json
  state          String          @default("QUEUED")
  generation     Int             @default(1)
  originJobId    String?
  originJob      PracticeJob?    @relation("PracticeRejudge", fields: [originJobId], references: [id])
  rejudges       PracticeJob[]   @relation("PracticeRejudge")
  attempt        Int             @default(0)
  fence          Int             @default(0)
  leaseOwner     String?
  leaseExpiresAt DateTime?
  availableAt    DateTime        @default(now())
  verdict        String?
  publicResult   Json?
  privateResult  Json?
  failureCode    String?
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  outbox         PracticeOutbox?
  scope          String          @default("PRACTICE") // "PRACTICE" | "CONTEST"
  contestId      String?
  admittedAt     DateTime?
  contestSubmission ContestSubmission?

  @@unique([ownerId, idempotencyKey])
  @@unique([originJobId, generation])
  @@index([state, availableAt])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([scope, state])
  @@index([contestId])
}

model PracticeOutbox {
  id          String      @id @default(uuid())
  jobId       String      @unique
  job         PracticeJob @relation(fields: [jobId], references: [id])
  attempts    Int         @default(0)
  availableAt DateTime    @default(now())
  deliveredAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([deliveredAt, availableAt])
}

model PracticeSolve {
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id])
  jobId     String
  updatedAt DateTime @updatedAt

  @@id([ownerId, problemId])
}

model RatingChange {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  contestId   String
  contest     Contest  @relation(fields: [contestId], references: [id])
  oldRating   Int
  newRating   Int
  delta       Int
  rank        Int
  performance Int?
  createdAt   DateTime @default(now())

  @@unique([userId, contestId])
  @@index([userId])
}

model Hack {
  id                 String   @id @default(uuid())
  contestId          String
  contest            Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  hackerId           String
  victimSubmissionId String
  testBlobKey        String
  succeeded          Boolean
  createdAt          DateTime @default(now())
}

// ─── Phase 3: Contests, Manifests, Scoring & Rating Ledger ───────────────────

model ContestManifest {
  id                  String    @id @default(uuid())
  contestId           String
  contest             Contest   @relation("ContestManifests", fields: [contestId], references: [id], onDelete: Cascade)
  revision            Int       @default(1)
  title               String
  slug                String
  description         String?
  startTime           DateTime
  endTime             DateTime
  registrationOpensAt DateTime
  registrationClosesAt DateTime
  freezeAt            DateTime?
  capacity            Int       @default(1000)
  isRated             Boolean   @default(false)
  divisionMin         Int?
  divisionMax         Int?
  scoringPolicy       String    @default("icpc-binary-v1")
  ratingPolicy        String    @default("codeforge-pairwise-elo-v1")
  problems            Json      // array of { label, orderIndex, problemId, versionId, packageHash, points, title }
  manifestHash        String
  runtimePolicyHash   String
  authorId            String
  author              User      @relation("ContestManifestAuthor", fields: [authorId], references: [id])
  reviewerId          String?
  reviewer            User?     @relation("ContestManifestReviewer", fields: [reviewerId], references: [id])
  status              String    @default("DRAFT") // "DRAFT" | "SEALED" | "SUPERSEDED"
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())

  activeForContests   Contest[] @relation("ActiveContestManifest")
  submissions         ContestSubmission[]

  @@unique([contestId, revision])
  @@index([contestId, status])
}

model ContestSubmission {
  id              String          @id @default(uuid())
  contestId       String
  contest         Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  manifestId      String
  manifest        ContestManifest @relation(fields: [manifestId], references: [id])
  problemId       String
  problem         Problem         @relation(fields: [problemId], references: [id])
  versionId       String
  version         PracticeVersion @relation(fields: [versionId], references: [id])
  problemLabel    String
  language        String
  source          String
  sourceHash      String
  idempotencyKey  String
  admittedAt      DateTime        @default(now())
  jobId           String          @unique
  job             PracticeJob     @relation(fields: [jobId], references: [id])
  state           String          @default("QUEUED")
  verdict         String?
  generation      Int             @default(1)
  isAuthoritative Boolean         @default(true)
  createdAt       DateTime        @default(now())

  @@unique([contestId, userId, idempotencyKey])
  @@index([contestId, admittedAt])
  @@index([contestId, problemLabel])
  @@index([contestId, userId])
}

model ContestScoreboardSnapshot {
  id          String   @id @default(uuid())
  contestId   String
  contest     Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  revision    Int      @default(1)
  isFrozen    Boolean  @default(false)
  asOfTime    DateTime @default(now())
  payload     Json     // complete computed scoreboard entries
  checksum    String   // SHA-256 of canonical payload
  createdAt   DateTime @default(now())

  @@unique([contestId, revision, isFrozen])
  @@index([contestId, createdAt(sort: Desc)])
}

model ContestRatingLedger {
  id              String   @id @default(uuid())
  generation      Int      @default(1)
  contestId       String
  contest         Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oldRating       Int
  newRating       Int
  delta           Int
  rank            Int
  performance     Int?
  isAuthoritative Boolean  @default(true)
  manifestHash    String
  scoringHash     String
  createdAt       DateTime @default(now())

  @@unique([generation, contestId, userId])
  @@index([userId, isAuthoritative])
  @@index([contestId, generation])
}

model ContestDispute {
  id               String    @id @default(uuid())
  contestId        String
  contest          Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String    // 'CHEATING_REPORT' | 'STATEMENT_AMBIGUITY' | 'TEST_FLAW' | 'SCORING_OBJECTION'
  status           String    @default("OPEN") // 'OPEN' | 'INVESTIGATING' | 'RESOLVED_REJUDGE' | 'RESOLVED_DISQUALIFIED' | 'DISMISSED'
  description      String
  resolutionReason String?
  resolvedById     String?
  resolvedBy       User?     @relation("DisputeResolver", fields: [resolvedById], references: [id])
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([contestId, status])
}

model ContestSettlementJob {
  id          String    @id @default(uuid())
  contestId   String
  contest     Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  operationId String    @unique
  type        String    // 'FINALIZE' | 'REPLAY' | 'CORRECTION'
  state       String    @default("QUEUED") // 'QUEUED' | 'RUNNING' | 'COMPLETED' | 'FAILED'
  generation  Int       @default(1)
  fence       Int       @default(0)
  workerId    String?
  errorReason String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([contestId, state])
}

// ─── Aptitude: items, tests, sessions ─────────────────────────────────────────

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  NUMERIC
  FILL_IN_BLANK
  TRUE_FALSE
  MATCH_FOLLOWING
  ORDERING
  DESCRIPTIVE
  CODE_SNIPPET
  SELECT_OUTPUT
  SQL_QUERY
  DRAG_DROP
  HOTSPOT
}

enum QuestionStatus {
  DRAFT
  REVIEWED
  CALIBRATING
  LIVE
  RETIRED
  SUPPRESSED
}

model QuizQuestion {
  id               String   @id @default(uuid())
  parentTemplateId String?
  version          Int      @default(1)

  type           QuestionType
  topic          String
  subtopic       String?
  cognitiveLevel String?

  stemMd  String
  payload Json
  sourceUrl String?
  license   String?
  rightsAttestedAt DateTime?

  difficultyBand   String
  estimatedSeconds Int      @default(60)
  tags             String[] @default([])
  companyTagged    String[] @default([])
  yearsSeen        Int[]    @default([])

  attemptCount    Int   @default(0)
  correctCount    Int   @default(0)
  pValue          Float?
  discrimination  Float?
  pointBiserial   Float?
  meanTimeSeconds Int?

  irtA Float?
  irtB Float?
  irtC Float?

  status     QuestionStatus @default(DRAFT)
  authorId   String
  reviewerId String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  responses QuizResponse[]
  testItems QuizTestItem[]

  @@index([status, topic])
  @@index([difficultyBand])
}

model QuizTest {
  id                  String   @id @default(uuid())
  slug                String   @unique
  title               String
  description         String?
  durationMinutes     Int
  sections            Json
  isAdaptive          Boolean  @default(false)
  randomizeOptions    Boolean  @default(true)
  randomizeOrder      Boolean  @default(true)
  passCutoffScaled    Int?
  sectionalCutoffsJson Json?
  proctorLevel        String   @default("strict")
  requireWebcam       Boolean  @default(true)
  requireFullscreen   Boolean  @default(true)
  requireScreenShare  Boolean  @default(false)
  status              String   @default("draft")
  reviewedBy          String?
  reviewedAt          DateTime?
  withdrawnBy         String?
  withdrawnAt         DateTime?
  withdrawalReason    String?
  createdAt           DateTime @default(now())

  attempts QuizAttempt[]
  items    QuizTestItem[]
}

model QuizTestItem {
  testId     String
  test       QuizTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id])
  section    String
  orderIndex Int
  weight     Float        @default(1)

  @@id([testId, questionId])
}

model QuizAttempt {
  id                    String    @id @default(uuid())
  testId                String
  test                  QuizTest  @relation(fields: [testId], references: [id])
  userId                String
  user                  User      @relation(fields: [userId], references: [id])
  activeKey             String?   @unique
  seed                  String
  startedAt             DateTime  @default(now())
  deadlineAt            DateTime?
  submittedAt           DateTime?
  durationActualSeconds Int?
  rawScore              Float?
  scaledScore           Int?
  percentile            Float?
  sectionalScores       Json      @default("{}")
  thetaEstimate         Float?
  suspicionScore        Int       @default(0)
  reviewStatus          String    @default("pending")
  reviewerId            String?
  reviewerNotes         String?

  responses     QuizResponse[]
  proctorEvents ProctorEvent[]
  screenChunks  ProctorRecording[]

  @@index([userId])
  @@index([testId])
}

model QuizResponse {
  id               String       @id @default(uuid())
  attemptId        String
  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         QuizQuestion @relation(fields: [questionId], references: [id])
  presentedOrder   Int
  optionOrderShown Int[]
  answerPayload    Json
  scoringSnapshot  Json?
  isCorrect        Boolean?
  pointsAwarded    Float        @default(0)
  markedForReview  Boolean      @default(false)
  firstShownAt     DateTime
  lastChangedAt    DateTime
  totalTimeSeconds Int
  changeCount      Int          @default(0)

  @@index([attemptId])
  @@index([questionId])
}

// ─── Proctoring & anti-cheat ─────────────────────────────────────────────────

model ProctorEvent {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  attemptId    String?
  attempt      QuizAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  submissionId String?
  eventType    String
  severity     String       @default("info")
  weight       Int          @default(1)
  payload      Json         @default("{}")
  serverTs     DateTime     @default(now())
  clientTs     DateTime?

  @@index([userId])
  @@index([attemptId])
  @@index([serverTs])
}

model ProctorRecording {
  id          String      @id @default(uuid())
  attemptId   String
  attempt     QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  kind        String
  s3Key       String
  startTs     DateTime
  endTs       DateTime
  retainUntil DateTime
}

model PlagiarismMatch {
  id               String     @id @default(uuid())
  fromSubmissionId String
  fromSubmission   Submission @relation("FromMatches", fields: [fromSubmissionId], references: [id])
  toSubmissionId   String
  toSubmission     Submission @relation("ToMatches", fields: [toSubmissionId], references: [id])
  similarity       Float
  algorithm        String
  matchedFragments Json       @default("[]")
  reviewStatus     String     @default("pending")
  createdAt        DateTime   @default(now())

  @@unique([fromSubmissionId, toSubmissionId, algorithm])
  @@index([similarity])
}

// ─── Engagement & community ──────────────────────────────────────────────────

model Badge {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String
  iconUrl     String?
  rarity      String      @default("common")
  users       UserBadge[]
}

model UserBadge {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@id([userId, badgeId])
}

model DailyChallenge {
  date      DateTime @id @db.Date
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id])
}

model StudyPlan {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  description  String
  problemIds   String[] @default([])
  durationDays Int
  isPublic     Boolean  @default(true)
}

model Discussion {
  id        String       @id @default(uuid())
  problemId String?
  problem   Problem?     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contestId String?
  authorId  String
  title     String?
  bodyMd    String
  parentId  String?
  parent    Discussion?  @relation("Replies", fields: [parentId], references: [id])
  replies   Discussion[] @relation("Replies")
  upvotes   Int          @default(0)
  downvotes Int          @default(0)
  isPinned  Boolean      @default(false)
  isLocked  Boolean      @default(false)
  isHidden  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([problemId])
  @@index([parentId])
}
