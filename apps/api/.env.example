# Copy to apps/api/.env and fill with real values from 1Password / Vault / Doppler.
# DO NOT commit a populated .env file. The example file ships placeholders only.
#
# IMPORTANT: a previous version of this file contained a real Supabase password
# in git history. See docs/RUNBOOKS/credential-rotation.md for the manual
# remediation steps that MUST be performed by the repo owner.

# Database
DATABASE_URL="postgresql://USER:REPLACE_ME@HOST:PORT/DATABASE?schema=public"

# Cache / queue
REDIS_URL="redis://localhost:6379"

# JWT — generate each via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_ME_64_BYTE_HEX_SECRET"
JWT_REFRESH_SECRET="REPLACE_ME_DIFFERENT_64_BYTE_HEX_SECRET"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Cookies
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"   # set to "true" in production
CSRF_SECRET="REPLACE_ME_32_BYTE_HEX"

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:5000"

# Email (Resend in production; dev logs the link to console)
EMAIL_PROVIDER="console"   # console | resend
RESEND_API_KEY=""
EMAIL_FROM="CodeForge <no-reply@example.com>"

# Observability
SENTRY_DSN=""

# Stage-0 local file-store for problem test blobs.
# A1 will replace this with S3 / R2.
SEED_BLOB_ROOT="./.local-blobs"

# Legacy — kept so existing piston-based submission flow still works.
# A1 will delete this when isolate-based judging lands.
PISTON_URL="https://emkc.org/api/v2/piston"
